true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;            event.clear()  &lt;span class=&#34;co&#34;&gt;# 红灯，清除标志位&lt;/span&gt;&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-10&#34;&gt;&lt;a href=&#34;#cb7-10&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;            &lt;span class=&#34;bu&#34;&gt;print&lt;/span&gt;(&lt;span class=&#34;st&#34;&gt;&amp;quot;&lt;/span&gt;&lt;span class=&#34;ch&#34;&gt;\33&lt;/span&gt;&lt;span class=&#34;st&#34;&gt;[41;1mred light is on...&lt;/span&gt;&lt;span class=&#34;ch&#34;&gt;\033&lt;/span&gt;&lt;span class=&#34;st&#34;&gt;[0m&amp;quot;&lt;/span&gt;)&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-11&#34;&gt;&lt;a href=&#34;#cb7-11&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;        &lt;span class=&#34;cf&#34;&gt;elif&lt;/span&gt; count &lt;span class=&#34;op&#34;&gt;&amp;gt;&lt;/span&gt; &lt;span class=&#34;dv&#34;&gt;10&lt;/span&gt;:&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-12&#34;&gt;&lt;a href=&#34;#cb7-12&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;            event.&lt;span class=&#34;bu&#34;&gt;set&lt;/span&gt;()  &lt;span class=&#34;co&#34;&gt;# 绿灯，设置标志位&lt;/span&gt;&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-13&#34;&gt;&lt;a href=&#34;#cb7-13&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;            count &lt;span class=&#34;op&#34;&gt;=&lt;/span&gt; &lt;span class=&#34;dv&#34;&gt;0&lt;/span&gt;&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-14&#34;&gt;&lt;a href=&#34;#cb7-14&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;        &lt;span class=&#34;cf&#34;&gt;else&lt;/span&gt;:&lt;/span&gt;&#xA;&lt;span id=&#34;cb7-15&#34;&gt;&lt;a href=&#34;#cb7-15&#34; aria-hidden=&#34;true&#34; tabindex=&#34;-1&#34;&gt;&lt;/a&gt;            &lt;span class=&#34;bu&#34;&gt;print&lt;/span&gt;(&lt;span class=&#34;st&#34;&gt;&amp;quot;&lt;/span&gt;&lt;span class=&#34;ch&#34;&gt;\33&lt;/span&gt;&lt;span class=&#34;st&#34;&gt;[42;1mgreen light is on...&lt;/span&gt;&lt;sp